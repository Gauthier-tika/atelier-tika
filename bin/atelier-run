#!/usr/bin/env python3
import argparse
import json
import os
import sys
import time

FINAL = ("done", "skipped", "failed")
EVENTS = 50


def run_path():
    run_id = os.environ.get("ATELIER_RUN_ID")
    runs_dir = os.environ.get("ATELIER_RUNS_DIR")
    if not run_id or not runs_dir:
        return None
    return os.path.join(runs_dir, os.path.basename(run_id) + ".json")


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"id": os.path.basename(path)[:-5]}


def save(path, run):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(run, f, indent=2)
    os.replace(tmp, path)


def record(run, text):
    now = int(time.time() * 1000)
    run["updated"] = now
    run["events"] = (run.get("events") or [])[-(EVENTS - 1):] + [{"at": now, "text": text}]
    return now


def apply(run, args):
    if args.command == "stage":
        run["status"] = "running"
        run["stage"] = args.text
        run["question"] = None
        run["stageSince"] = record(run, args.text)
    elif args.command == "ticket":
        run["ticket"] = args.key.upper()
        record(run, f"Ticket {run['ticket']}")
    elif args.command == "ask":
        run["status"] = "waiting"
        run["question"] = {"text": args.text, "options": args.options, "asked": record(run, args.text)}
    elif args.command in ("done", "skip", "fail"):
        status = {"done": "done", "skip": "skipped", "fail": "failed"}[args.command]
        message = args.message or ""
        run["status"] = status
        run["question"] = None
        run["message"] = message
        if getattr(args, "pr", None):
            run["pr"] = args.pr
        run["finishedAt"] = record(run, message or status.capitalize())


def parser():
    root = argparse.ArgumentParser(prog="atelier-run", description="Report the progress of an Atelier workflow run")
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("stage", help="Set the current stage").add_argument("text")
    commands.add_parser("ticket", help="Link the run to a Jira ticket").add_argument("key")
    ask = commands.add_parser("ask", help="Wait for a choice made in Atelier")
    ask.add_argument("text")
    ask.add_argument("options", nargs="+")
    done = commands.add_parser("done", help="Finish the run")
    done.add_argument("--pr")
    done.add_argument("--message")
    for name in ("skip", "fail"):
        commands.add_parser(name).add_argument("message", nargs="?")
    return root


def main():
    args = parser().parse_args()
    path = run_path()
    if not path:
        print("atelier-run: not started by Atelier, nothing recorded", file=sys.stderr)
        return 0
    run = load(path)
    if run.get("status") in FINAL:
        print(f"atelier-run: run already {run['status']}", file=sys.stderr)
        return 0
    apply(run, args)
    save(path, run)
    return 0


if __name__ == "__main__":
    sys.exit(main())
